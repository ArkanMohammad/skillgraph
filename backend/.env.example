# Copy this file to .env and edit the values for your machine.
# Never commit the real .env file.

PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillgraph

# Secret used to sign the login token. Use a random value of at least 32 characters
# (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret

# The exact address of the frontend, without a trailing slash (CORS compares it exactly)
CLIENT_URL=http://localhost:5173

# Set this only on the production server: login cookies become HTTPS-only and
# only CLIENT_URL is allowed by CORS
# NODE_ENV=production